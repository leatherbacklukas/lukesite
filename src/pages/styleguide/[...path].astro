---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Dev-only reference page for the design tokens and section patterns. Never built for production.
export const getStaticPaths = (() =>
  import.meta.env.DEV ? [{ params: { path: undefined } }] : []) satisfies GetStaticPaths;

const swatches = [
  ['canvas', 'Page background, intro section'],
  ['surface', 'Raised surface'],
  ['line', 'Borders, rules'],
  ['muted', 'Secondary text'],
  ['ink', 'Body text'],
  ['accent', 'Links, interaction (text-safe orange)'],
  ['accent-on-band', 'Links inside peach bands'],
  ['accent-bright', 'Decoration only: rules, underlines, selection'],
  ['cerulean', 'Headings, header, footer, contact block'],
  ['peach', 'Section band'],
  ['peach-light', 'Alternate section band'],
  ['teal', 'Tertiary accent, rare'],
];

const work = [
  {
    year: '2026',
    title: 'Roll for Reality',
    summary:
      'A live improvised tabletop roleplaying performance combining real-time virtual production, motion capture, and Unreal Engine.',
    meta: 'Production · Virtual Production · Improv',
  },
  {
    year: '2025',
    title: 'Pipeline Tooling for Real-Time Cinematics',
    summary:
      'Tools that let a small team move animation and camera data from capture to final shot without hand-editing files.',
    meta: 'Project · Engineering · Cinematics & VFX',
  },
  {
    year: '2024',
    title: 'Immersive Pavilion',
    summary: 'Volunteer leadership for an exhibition of XR and immersive work at a major conference.',
    meta: 'Volunteering · XR / Immersive',
  },
];

const areas = [
  ['Career', 'Engineering, pipelines, and technical art.'],
  ['Cinematics, VFX & Virtual Production', 'Real-time production and filmmaking technology.'],
  ['Gaming', 'Games, professionally and personally.'],
  ['Improv Comedy', 'Performing, musical improv, and teaching.'],
  ['Volunteering & Community', 'Conferences, committees, and mentoring.'],
];

const experience = [
  ['Senior Pipeline Engineer', 'Example Studio', '2023 – now'],
  ['Technical Artist', 'Another Studio', '2020 – 2023'],
  ['Committee Member', 'Example Conference', '2022 – now'],
];
---

<BaseLayout title="Styleguide">
  <section class="page-container py-section">
    <div class="max-w-measure">
      <h1 class="text-display">Engineering and creative technology, side by side.</h1>
      <p class="mt-block text-lg text-muted">
        I build pipelines and tools for real-time cinematics and virtual production, and I perform
        and teach improv. This sample intro shows the type, color, and spacing together. <a
          href="#">Read more about me</a
        >.
      </p>
    </div>
  </section>

  <section aria-labelledby="sg-work" class="band">
    <div class="page-container">
      <h2 id="sg-work" class="text-title">Selected work</h2>
      <ul class="mt-block border-t border-line">
        {
          work.map((w) => (
            <li class="grid items-baseline gap-x-8 gap-y-1 border-b border-line py-block sm:grid-cols-[5rem_1fr]">
              <span class="text-sm text-muted tabular-nums">{w.year}</span>
              <div>
                <h3 class="text-xl font-semibold">
                  <a href="#" class="text-ink no-underline hover:text-accent hover:underline">
                    {w.title}
                  </a>
                </h3>
                <p class="mt-1 max-w-measure">{w.summary}</p>
                <p class="mt-2 text-sm text-muted">{w.meta}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="sg-areas" class="band">
    <div class="page-container">
      <h2 id="sg-areas" class="text-title">Areas</h2>
      <dl class="mt-block grid gap-x-10 gap-y-block sm:grid-cols-2 lg:grid-cols-3">
        {
          areas.map(([name, text], i) => (
            <div
              class:list={[
                'border-t-2 pt-3',
                i % 3 === 0 && 'border-accent-bright',
                i % 3 === 1 && 'border-cerulean',
                i % 3 === 2 && 'border-teal',
              ]}
            >
              <dt class="font-semibold">{name}</dt>
              <dd class="mt-1 text-muted">{text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section aria-labelledby="sg-exp" class="band">
    <div class="page-container">
      <h2 id="sg-exp" class="text-title">Selected experience</h2>
      <ul class="mt-block max-w-measure border-t border-line">
        {
          experience.map(([role, org, years]) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-6 border-b border-line py-3">
              <span>
                <span class="font-semibold">{role}</span>
                <span class="text-muted"> · {org}</span>
              </span>
              <span class="text-sm text-muted tabular-nums">{years}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="sg-prose" class="band">
    <div class="page-container">
      <h2 id="sg-prose" class="text-title">Detail page body</h2>
      <div class="prose mt-block max-w-measure">
        <p>
          Roll for Reality started as a question: what happens when the people improvising a
          tabletop game are also driving characters in a real-time virtual set? This paragraph is
          set at reading width with an <a href="#">inline link</a> and some <strong>bold text</strong>.
        </p>
        <h3>My role</h3>
        <ul>
          <li>Built the capture-to-engine pipeline for performers.</li>
          <li>Ran the technical side of rehearsals and shows.</li>
        </ul>
        <blockquote>
          <p>A pull quote, to see how the bright accent works as a rule.</p>
        </blockquote>
      </div>
      <figure class="mt-block">
        <div class="flex aspect-[21/9] items-center justify-center bg-surface text-muted">
          Wide media breakout (max-w-wide)
        </div>
        <figcaption class="mt-2 text-sm text-muted">Caption text for a production still.</figcaption>
      </figure>
    </div>
  </section>

  <section aria-labelledby="sg-type" class="band">
    <div class="page-container">
      <h2 id="sg-type" class="text-title">Type</h2>
      <div class="mt-block space-y-4">
        <p class="heading text-display">Display heading</p>
        <p class="heading text-title">Title heading</p>
        <p class="text-xl font-semibold">Heading 3 · Instrument Sans semibold</p>
        <p>Body · Instrument Sans regular. The quick brown fox jumps over the lazy dog.</p>
        <p class="text-sm text-muted">Small / meta · Instrument Sans</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="sg-color" class="band">
    <div class="page-container">
      <h2 id="sg-color" class="text-title">Color tokens</h2>
      <ul class="mt-block grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          swatches.map(([token, use]) => (
            <li class="flex items-center gap-3">
              <span
                class="size-12 shrink-0 border border-line"
                style={`background: var(--${token})`}
              />
              <span>
                <code class="text-sm">{token}</code>
                <span class="block text-sm text-muted">{use}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-block">
        Text samples: <a href="#">accent link</a> · <span class="text-cerulean">cerulean text</span> ·
        <span class="text-teal">teal text</span> · <span class="text-muted">muted text</span>
      </p>
      <p class="mt-2 text-sm text-muted">Press Tab to see focus outlines on links.</p>
    </div>
  </section>

  <div class="page-container py-section">
    <section aria-labelledby="sg-cta" class="sg-cta bg-cerulean text-on-cerulean">
      <h2 id="sg-cta" class="text-title">Get in touch</h2>
      <p class="mt-3 max-w-measure">
        For collaborations, talks, or shows: <a href="#">hello@example.com</a>
      </p>
    </section>
  </div>

  <style>
    .sg-cta {
      padding: var(--block-gap) calc(var(--block-gap) * 1.25);
    }
    .sg-cta :is(h2, a) {
      color: var(--on-cerulean);
    }
    .sg-cta a {
      text-decoration-color: var(--accent-bright);
    }
    .sg-cta a:focus-visible {
      outline-color: var(--on-cerulean);
    }
  </style>
</BaseLayout>
