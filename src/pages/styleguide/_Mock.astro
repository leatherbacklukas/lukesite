---
// A miniature page used by /styleguide/compare. The leading underscore keeps it out of routing.
export type Tone =
  | 'cerulean'
  | 'peach'
  | 'teal'
  | 'cerulean-deep'
  | 'teal-deep'
  | 'peach-light'
  | 'coral'
  | 'apricot'
  | 'caramel'
  | 'butter'
  | 'sage'
  | 'lavender'
  | 'blush'
  | undefined;

interface Props {
  code: string;
  label: string;
  h1: string;
  h2: string;
  tones: [Tone, Tone, Tone, Tone];
  note?: string;
}

const { code, label, h1, h2, tones, note } = Astro.props;
---

<figure>
  <figcaption class="mb-3">
    <span class="font-semibold">{code}</span>
    <span class="text-muted"> · {label}</span>
    {note && <span class="mt-0.5 block text-sm text-muted">{note}</span>}
  </figcaption>

  <div class="mock border border-line" style={`--mock-h1: ${h1}; --mock-h2: ${h2};`}>
    <div class="flex items-baseline justify-between bg-cerulean px-6 py-3 text-sm text-on-cerulean">
      <span class="heading text-base text-on-cerulean">Lukas Tannenbaum</span>
      <span class="flex gap-4">
        <span class="underline decoration-accent-bright decoration-2 underline-offset-4">Work</span>
        <span>About</span>
        <span>Contact</span>
      </span>
    </div>

    <div class="px-6 pt-8 pb-7">
      <p class="heading m-h1 text-[2rem] leading-tight">
        Engineering and creative technology, side by side.
      </p>
      <p class="mt-3 text-muted">
        I build pipelines for real-time cinematics, and I perform and teach improv. <a href="#"
          >Read more</a
        >.
      </p>
    </div>

    <section class="mock-sec px-6 py-7" data-tone={tones[0]}>
      <p class="heading m-h2 text-[1.375rem]">Selected work</p>
      <ul class="mt-4 border-t border-line">
        <li class="grid grid-cols-[3rem_1fr] items-baseline gap-x-4 border-b border-line py-3">
          <span class="text-xs text-muted tabular-nums">2026</span>
          <span>
            <span class="block font-semibold">Roll for Reality</span>
            <span class="text-sm text-muted">Production · Virtual Production · Improv</span>
          </span>
        </li>
        <li class="grid grid-cols-[3rem_1fr] items-baseline gap-x-4 border-b border-line py-3">
          <span class="text-xs text-muted tabular-nums">2025</span>
          <span>
            <span class="block font-semibold">Pipeline Tooling for Real-Time Cinematics</span>
            <span class="text-sm text-muted">Project · Engineering · Cinematics & VFX</span>
          </span>
        </li>
      </ul>
    </section>

    <section class="mock-sec px-6 py-7" data-tone={tones[1]}>
      <p class="heading m-h2 text-[1.375rem]">Areas</p>
      <div class="mt-4 grid grid-cols-3 gap-4 text-sm">
        <div class="border-t-2 border-accent-bright pt-2">
          <span class="block font-semibold">Career</span>
          <span class="text-muted">Engineering and technical art.</span>
        </div>
        <div class="border-t-2 border-cerulean pt-2">
          <span class="block font-semibold">Cinematics & VP</span>
          <span class="text-muted">Real-time production.</span>
        </div>
        <div class="border-t-2 border-teal pt-2">
          <span class="block font-semibold">Improv Comedy</span>
          <span class="text-muted">Performing and teaching.</span>
        </div>
      </div>
    </section>

    <section class="mock-sec px-6 py-7" data-tone={tones[2]}>
      <p class="heading m-h2 text-[1.375rem]">Selected experience</p>
      <ul class="mt-4 border-t border-line text-sm">
        <li class="flex justify-between gap-4 border-b border-line py-2">
          <span><span class="font-semibold">Senior Pipeline Engineer</span><span class="text-muted"> · Example Studio</span></span>
          <span class="text-muted tabular-nums">2023 – now</span>
        </li>
        <li class="flex justify-between gap-4 border-b border-line py-2">
          <span><span class="font-semibold">Committee Member</span><span class="text-muted"> · Example Conference</span></span>
          <span class="text-muted tabular-nums">2022 – now</span>
        </li>
      </ul>
    </section>

    <section class="mock-sec px-6 py-7" data-tone={tones[3]}>
      <p class="heading m-h2 text-[1.375rem]">About</p>
      <p class="mt-3">
        Engineer by day, improviser by night, and usually somewhere in between. <a href="#"
          >More about me</a
        >.
      </p>
    </section>

    <div class="px-6 pt-2 pb-8">
      <div class="bg-cerulean px-5 py-5 text-on-cerulean">
        <p class="heading text-[1.375rem] text-on-cerulean">Get in touch</p>
        <p class="mt-1 text-sm">
          hello@example.com
        </p>
      </div>
    </div>

    <div class="bg-cerulean px-6 py-3 text-xs text-on-cerulean">© 2026 Lukas Tannenbaum</div>
  </div>
</figure>

<style>
  .mock {
    background: var(--canvas);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .m-h1 {
    color: var(--mock-h1);
  }
  .m-h2 {
    color: var(--mock-h2);
  }
  .mock-sec[data-tone] {
    --accent: #a33206;
  }
  .mock-sec[data-tone='cerulean'] {
    --line: #bfd0e8;
    background: #dce6f3;
  }
  .mock-sec[data-tone='peach'] {
    --line: #e3b195;
    background: #f3cfb8;
  }
  .mock-sec[data-tone='peach-light'] {
    --line: #edc9b2;
    background: #f8e3d5;
  }
  .mock-sec[data-tone='coral'] {
    --line: #e6a896;
    background: #f5c6b8;
  }
  .mock-sec[data-tone='apricot'] {
    --line: #e6c487;
    background: #f6ddb0;
  }
  .mock-sec[data-tone='caramel'] {
    --line: #d4b394;
    background: #e8cdb2;
  }
  .mock-sec[data-tone='teal'] {
    --line: #aed3c9;
    background: #d2e8e2;
  }
  .mock-sec[data-tone='cerulean-deep'] {
    --line: #aac2e4;
    background: #cfddf1;
  }
  .mock-sec[data-tone='teal-deep'] {
    --line: #9fcbbd;
    background: #c4e2d9;
  }
  .mock-sec[data-tone='butter'] {
    --line: #e2cd8c;
    background: #f3e4b5;
  }
  .mock-sec[data-tone='sage'] {
    --line: #bfcca8;
    background: #dce4cc;
  }
  .mock-sec[data-tone='lavender'] {
    --line: #c4bce0;
    background: #e1dcf0;
  }
  .mock-sec[data-tone='blush'] {
    --line: #e0b5b1;
    background: #f2d5d3;
  }
</style>
