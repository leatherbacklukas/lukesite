---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import VideoGrid from '../../components/content/VideoGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPortfolio, hasDetailPage, type PortfolioEntry } from '../../lib/content';

export const getStaticPaths = (async () => {
  const entries = await getPortfolio();
  return entries.filter(hasDetailPage).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: PortfolioEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { images = [], videos } = entry.data;
const hasBody = Boolean(entry.body?.trim());
const hasImages = images.length > 0;
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="page-container py-section">
      <h1 class="text-display">{entry.data.title}</h1>
      <p class="mt-4 text-muted">{entry.data.summary}</p>
    </header>
    {
      (hasBody || hasImages) && (
        <div class="band">
          <div class="page-container grid items-start gap-x-16 gap-y-block lg:grid-cols-[minmax(0,40rem)_minmax(0,1fr)]">
            {hasBody && (
              <div class="prose max-w-measure">
                <Content />
              </div>
            )}
            {hasImages && (
              <div class:list={['flex flex-col gap-block', !hasBody && 'lg:col-span-2']}>
                {images.map((img) => (
                  <figure>
                    <Image
                      src={img.src}
                      alt={img.alt}
                      widths={[480, 960, 1440]}
                      sizes="(min-width: 1024px) 28rem, 100vw"
                      class="h-auto w-full"
                    />
                    {img.caption && (
                      <figcaption class="mt-2 text-sm text-muted">{img.caption}</figcaption>
                    )}
                  </figure>
                ))}
              </div>
            )}
          </div>
        </div>
      )
    }
    {
      videos && videos.length > 0 && (
        <section aria-label="Videos" class="band">
          <div class="page-container">
            <VideoGrid videos={videos} />
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
