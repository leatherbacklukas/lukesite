---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPortfolio, hasDetailPage, type PortfolioEntry } from '../../lib/content';

export const getStaticPaths = (async () => {
  const entries = await getPortfolio();
  return entries.filter(hasDetailPage).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: PortfolioEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <h1 class="text-display">{entry.data.title}</h1>
    <p class="mt-4 text-muted">{entry.data.summary}</p>
    <div class="prose mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
