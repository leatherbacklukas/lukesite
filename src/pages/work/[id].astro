---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import VideoGrid from '../../components/content/VideoGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPortfolio, hasDetailPage, type PortfolioEntry } from '../../lib/content';

export const getStaticPaths = (async () => {
  const entries = await getPortfolio();
  return entries.filter(hasDetailPage).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: PortfolioEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { videos } = entry.data;
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="page-container py-section">
      <h1 class="text-display">{entry.data.title}</h1>
      <p class="mt-4 text-muted">{entry.data.summary}</p>
    </header>
    {
      entry.body?.trim() && (
        <div class="band">
          <div class="page-container">
            <div class="prose max-w-measure">
              <Content />
            </div>
          </div>
        </div>
      )
    }
    {
      videos && videos.length > 0 && (
        <section aria-label="Videos" class="band">
          <div class="page-container">
            <VideoGrid videos={videos} />
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
