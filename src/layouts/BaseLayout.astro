---
import { Font } from 'astro:assets';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const SITE_NAME = 'Lukas Tannenbaum';
const { title, description = 'Personal site and portfolio of Lukas Tannenbaum.' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <Font cssVariable="--font-instrument-sans" preload />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-canvas focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <SiteHeader siteName={SITE_NAME} />
    <main id="main" class="mx-auto w-full max-w-wide flex-1 px-gutter py-section">
      <slot />
    </main>
    <SiteFooter siteName={SITE_NAME} />
  </body>
</html>
